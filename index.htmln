<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Happy Birthday Nandini 💜</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
overflow:hidden;
display:flex;
justify-content:center;
align-items:center;
height:100vh;
background:linear-gradient(135deg,#4b0082,#7b2cbf,#c77dff);
color:white;
text-align:center;
}

.container{
z-index:2;
padding:20px;
}

.gift{
font-size:120px;
cursor:pointer;
animation:bounce 2s infinite;
transition:.4s;
}

.gift:hover{
transform:scale(1.1);
}

@keyframes bounce{
0%,100%{transform:translateY(0);}
50%{transform:translateY(-15px);}
}

.message{
display:none;
animation:fadeIn 2s;
}

@keyframes fadeIn{
from{
opacity:0;
transform:scale(.8);
}
to{
opacity:1;
transform:scale(1);
}
}

.letter{
margin:25px auto;
padding:25px;
max-width:500px;
background:rgba(255,255,255,.15);
border-radius:20px;
backdrop-filter:blur(10px);
box-shadow:0 0 20px rgba(255,255,255,.25);
animation:letter 2s;
}

@keyframes letter{
from{
transform:translateY(50px);
opacity:0;
}
to{
transform:translateY(0);
opacity:1;
}
}

h1{
font-size:45px;
margin-bottom:10px;
}

h2{
margin-bottom:15px;
}

p{
font-size:20px;
line-height:1.7;
}

.heart{
position:absolute;
animation:float 6s linear forwards;
pointer-events:none;
}

@keyframes float{
0%{
transform:translateY(100vh) scale(.5);
opacity:1;
}
100%{
transform:translateY(-120vh) scale(1.5);
opacity:0;
}
}
</style>

</head>

<body>

<div class="container">

<div id="gift" class="gift" onclick="openGift()">
🎁
</div>

<div id="content" class="message">

<h1>💜 Happy Birthday Nandini 💜</h1>

<h2>✨ You Opened Your Surprise! ✨</h2>

<div class="letter">

<h2>💌 A Letter For You 💌</h2>

<p>
Dear <b>Nandini</b>, 💜
<br><br>

Happy Birthday! 🎂✨

<br><br>

I hope today brings you endless smiles, beautiful memories, and all the happiness in the world.

<br><br>

You deserve love, laughter, success, and every wonderful thing life has to offer.

<br><br>

<b>I Love You. ❤️</b>

<br><br>

May every dream you have come true, and may your heart always stay filled with joy.

<br><br>

Never stop smiling, because your smile makes the world a little brighter. 🌸

<br><br>

🎉 Have the most magical birthday ever! 🎂💜
</p>

</div>

</div>

</div>

<script>

function openGift(){

document.getElementById("gift").style.display="none";

document.getElementById("content").style.display="block";

for(let i=0;i<200;i++){
setTimeout(createHeart,i*35);
}

}

function createHeart(){

let heart=document.createElement("div");

heart.className="heart";

let hearts=["💜","💖","❤️","✨"];

heart.innerHTML=hearts[Math.floor(Math.random()*hearts.length)];

heart.style.left=Math.random()*100+"vw";

heart.style.fontSize=(20+Math.random()*35)+"px";

document.body.appendChild(heart);

setTimeout(()=>{
heart.remove();
},6000);

}

setInterval(createHeart,300);

</script>

</body>
</html><!DOCTYPE html>
